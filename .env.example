# Public WordPress origin used only by the Next.js server.
WORDPRESS_URL=http://localhost/nutzen-wp

# Public URL of this Next.js application, used by WordPress webhooks.
FRONTEND_URL=http://localhost:3000

# Shared HMAC secret for WordPress -> Next.js cache invalidation.
NUTZEN_REVALIDATE_SECRET=replace-with-a-long-random-secret

# Public browser credential used by MercadoPago.js to tokenize card data.
# This is a public key, never the Mercado Pago Access Token.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Server-only WooCommerce REST API credentials. Do not prefix with NEXT_PUBLIC_.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
